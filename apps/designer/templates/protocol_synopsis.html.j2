<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{ synopsis.protocol_title }} — Protocol Synopsis</title>
    <style>
        body { font-family: 'Helvetica Neue', Arial, sans-serif; color: #222; margin: 40px; line-height: 1.6; }
        h1 { color: #0f4c81; border-bottom: 2px solid #0f4c81; padding-bottom: 8px; }
        h2 { color: #1e3a8a; margin-top: 24px; border-bottom: 1px solid #ddd; padding-bottom: 4px; }
        .meta-table, .soa-table { width: 100%; border-collapse: collapse; margin-top: 16px; }
        .meta-table th, .meta-table td, .soa-table th, .soa-table td { border: 1px solid #ccc; padding: 10px; text-align: left; }
        .meta-table th { background-color: #f3f4f6; width: 30%; font-weight: bold; }
        .soa-table th { background-color: #0f4c81; color: white; }
        .soa-cell-active { background-color: #d1fae5; text-align: center; font-weight: bold; color: #065f46; }
        .soa-cell-inactive { background-color: #f9fafb; text-align: center; color: #9ca3af; }
        .badge { display: inline-block; padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight: bold; background: #e0f2fe; color: #0369a1; }
    </style>
</head>
<body>
    <h1>Clinical Protocol Synopsis</h1>

    <table class="meta-table">
        <tr>
            <th>Protocol Title</th>
            <td>{{ synopsis.protocol_title or 'N/A' }}</td>
        </tr>
        <tr>
            <th>Short Title / ID</th>
            <td><span class="badge">{{ synopsis.short_title or 'N/A' }}</span></td>
        </tr>
        <tr>
            <th>Protocol Version</th>
            <td>{{ metadata.version_index or 1 }} (GxP Change Reason: {{ metadata.change_reason or 'Initial Baseline' }})</td>
        </tr>
        <tr>
            <th>Document Author / Creator</th>
            <td>{{ metadata.creator or 'Cadence Clinical DDF Engine' }}</td>
        </tr>
    </table>

    <h2>1. Study Design & Objectives</h2>
    <p><strong>Design Summary:</strong> {{ synopsis.design_summary or 'No specific design summary provided.' }}</p>

    <h2>2. Eligibility Criteria</h2>
    <h3>Inclusion Criteria</h3>
    {% if synopsis.inclusion_criteria %}
    <ul>
        {% for crit in synopsis.inclusion_criteria %}
        <li>{{ crit }}</li>
        {% endfor %}
    </ul>
    {% else %}
    <p><em>No inclusion criteria specified.</em></p>
    {% endif %}

    <h3>Exclusion Criteria</h3>
    {% if synopsis.exclusion_criteria %}
    <ul>
        {% for crit in synopsis.exclusion_criteria %}
        <li>{{ crit }}</li>
        {% endfor %}
    </ul>
    {% else %}
    <p><em>No exclusion criteria specified.</em></p>
    {% endif %}

    <h2>3. Schedule of Activities (SoA)</h2>
    {% if soa_matrix and soa_matrix.rows %}
    <table class="soa-table">
        <thead>
            <tr>
                <th>Procedure / Activity</th>
                {% for enc in soa_matrix.encounters %}
                <th>{{ enc.encounter_name or enc.encounter_id }}</th>
                {% endfor %}
            </tr>
        </thead>
        <tbody>
            {% for row in soa_matrix.rows %}
            <tr>
                <td><strong>{{ row.activity_name }}</strong></td>
                {% for cell in row.cells %}
                    {% if cell.is_applicable %}
                    <td class="soa-cell-active">✓</td>
                    {% else %}
                    <td class="soa-cell-inactive">—</td>
                    {% endif %}
                {% endfor %}
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% else %}
    <p><em>No Schedule of Activities matrix configured.</em></p>
    {% endif %}

</body>
</html>
